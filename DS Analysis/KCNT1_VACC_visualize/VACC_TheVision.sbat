#!/bin/bash
#SBATCH --array=1-9
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128gb
#SBATCH --time=0-6:00:00
#SBATCH --job-name=vacc_vision_array
#SBATCH --output=/users/s/a/sakhava1/scratch/logs/vacc_vision_%A_%a.out
#SBATCH --error=/users/s/a/sakhava1/scratch/logs/vacc_vision_%A_%a.err

module load matlab

SCRIPT_DIR="/users/s/a/sakhava1/scratch/KCNT1 Urethane"

# 1) folders (order matters — must match array size above)
dirs=(
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M10s2"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M11s6"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M12s4"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M13s3"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M15s4"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M15s6"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M17s2"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M6s4"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA/Kcnt1_M9s3"
)

# 2) fiftyNineBad flags aligned to the dirs above
flags=(true true true true true true true true true)

DATA_DIR="${dirs[$SLURM_ARRAY_TASK_ID-1]}"
FIFTYNINEBAD="${flags[$SLURM_ARRAY_TASK_ID-1]}"

echo "Running VACC_TheVision on:"
echo "  DIR   = $DATA_DIR"
echo "  FLAG  = $FIFTYNINEBAD"

matlab -nodisplay -nosplash -r "addpath('$SCRIPT_DIR'); VACC_TheVision('$DATA_DIR', $FIFTYNINEBAD); exit"
