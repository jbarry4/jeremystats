#!/bin/bash
#SBATCH --array=1-9
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=800gb
#SBATCH --time=0-12:00:00
#SBATCH --job-name=ied_detect_hp_lp_nf
#SBATCH --output=/users/s/a/sakhava1/scratch/logs/ied_detect_v2_%A_%a.out
#SBATCH --error=/users/s/a/sakhava1/scratch/logs/ied_detect_v2_%A_%a.err

module load matlab

TAKE2_DIR="/users/s/a/sakhava1/scratch/KCNT1 Urethane/Take 2"
REQS_DIR="/users/s/a/sakhava1/scratch/KCNT1 Urethane/reqsPath"

dirs=(
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M2s2"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M4s2"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M5s2"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M7s3"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M8s3"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M14s2"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M19s4"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M22s2"
  "/users/s/a/sakhava1/scratch/KCNT1 Urethane/KCNT1_DATA_NEW/Kcnt1_M22s3"
)

#Bif if:
flags=(true true true true true true true true true)

DATA_DIR="${dirs[$SLURM_ARRAY_TASK_ID-1]}"
EIGHTBAD="${flags[$SLURM_ARRAY_TASK_ID-1]}"

echo "1_1_ied_detect | DIR=$DATA_DIR | fiftyNineBad=$EIGHTBAD"

matlab -nodisplay -nosplash -r "addpath('${TAKE2_DIR}'); addpath('${REQS_DIR}'); basePath='${DATA_DIR}'; fiftyNineBad=${EIGHTBAD}; eval(fileread('${TAKE2_DIR}/1_1_ied_detect.m')); exit"
