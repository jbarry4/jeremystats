#!/bin/bash
#SBATCH --array=1-2
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=200gb
#SBATCH --time=0-6:00:00
#SBATCH --job-name=vacc_array

module load matlab
cd /gpfs2/scratch/sakhava1/Batch_Process_All

# 1) folders (order matters)
dirs=(


  "/gpfs2/scratch/sakhava1/Batch_Process_All/myDATA/PTEN/m28_ptenblind/m28s15jun19/Clean"
  "/gpfs2/scratch/sakhava1/Batch_Process_All/myDATA/PTEN/M34_ptenblind/m34s8jun10/Clean Data (No gaps)"

)

# 2) eightBad flags aligned to the dirs above
flags=(true true)

DATA_DIR=${dirs[$SLURM_ARRAY_TASK_ID-1]}
EIGHTBAD=${flags[$SLURM_ARRAY_TASK_ID-1]}

echo "Running vacc_ied_detect on:"
echo "  DIR      = $DATA_DIR"
echo "  eightBad = $EIGHTBAD"

# Pass the logical literal (true/false) into MATLAB (no quotes around it)
matlab -nodisplay -nosplash -r "vacc_ied_detect('$DATA_DIR', $EIGHTBAD); exit"
