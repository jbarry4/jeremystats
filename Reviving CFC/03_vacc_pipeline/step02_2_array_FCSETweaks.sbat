#!/bin/bash

#SBATCH --job-name=arrayFCSE
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
### Number of workers for Matlab
#SBATCH --cpus-per-task=8
### Should be 4 * cpus-per-task
#SBATCH --mem=32g
#SBATCH --time=15:00
#SBATCH --array=1-3

module purge 
module load matlab/R2023b

my_job_header

echo -n "Array variable for this job:  "
env | grep '^SLURM_ARRAY_TASK_ID='

#---- Begin real job work here

cd /users/c/r/crweinst/PPP/vacc

matlab -softwareopengl -nodesktop -r "arrayFCSETweaks('$SLURM_ARRAY_TASK_ID') ; exit"
